# Python / uv
.venv/
__pycache__/
*.pyc

# dbt artifacts (generated, machine-specific)
**/target/
**/dbt_packages/
**/logs/
**/.user.yml

# dbt credentials — NEVER commit (lives in ~/.dbt/profiles.yml)
**/profiles.yml

# Airflow secrets — NEVER commit (Fernet key, JWT secret)
airflow/.env

# Generated by the airflow-init container on first start; contains fernet_key,
# secret_key and jwt_secret. Regenerated automatically, never commit it.
airflow/config/airflow.cfg

# Editor / OS
.vscode/
.DS_Store
