# Copy to airflow/.env and fill in. airflow/.env is gitignored — never commit it.
#
#   cp airflow/.env.example airflow/.env
#
AIRFLOW_UID=50000

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Databricks workspace. host NEEDS the https:// prefix here (the dbt profiles.yml
# equivalent does NOT — that one takes the bare hostname).
# Token: Databricks > Settings > Developer > Access tokens.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-personal-access-token>
DATABRICKS_CDC_JOB_ID=<databricks-job-id-for-the-cdc-ingest>
